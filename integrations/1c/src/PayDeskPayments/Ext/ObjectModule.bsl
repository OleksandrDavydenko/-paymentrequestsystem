// Обробка «Платіжки із заявок PayDesk».
// Забирає з PayDesk заявки «До оплати» (API /api/1c/v1, ключ X-Api-Key), створює чернетки платіжних доручень
// і повідомляє PayDesk номер документа або помилку. Уся логіка — тут (виконується на сервері), форма — лише інтерфейс.
// Опис API — integrations/1c/README.md у репозиторії PayDesk.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Перевірка зв'язку й ключа. Повертає Соответствие {"ok", "app", "api", "time"}.
Функция Пинг(Адрес, Ключ) Экспорт
	Возврат ЗапросPayDesk(Адрес, Ключ, "GET", "/api/1c/v1/ping");
КонецФункции

// Заявки з PayDesk. Состояние — new / failed / created / cancelled / all; ФормаОплаты — bank / cash / "" (усі).
// Повертає Массив Соответствий (поля — див. README, розділ «Платіжка»).
Функция ПолучитьЗаявки(Адрес, Ключ, Состояние = "new", ФормаОплаты = "") Экспорт
	Путь = "/api/1c/v1/payment-orders?state=" + Состояние;
	Если ЗначениеЗаполнено(ФормаОплаты) Тогда
		Путь = Путь + "&form=" + ФормаОплаты;
	КонецЕсли;
	Ответ = ЗапросPayDesk(Адрес, Ключ, "GET", Путь);
	Список = Ответ.Получить("items");
	Возврат ?(ТипЗнч(Список) = Тип("Массив"), Список, Новый Массив);
КонецФункции

// Створити платіжку за заявкою (Соответствие з API) і повідомити PayDesk.
// Правила — ТаблицаЗначений (Реквизит, Источник, Справочник, РеквизитПоиска, ПолеПоиска): який реквізит документа
// чим заповнити. Повертає Структура (Успех, Номер, Сообщение, Предупреждения).
Функция СоздатьПлатежку(Адрес, Ключ, ВидДокумента, Заявка, Правила) Экспорт
	Результат = Новый Структура("Успех, Номер, Сообщение, Предупреждения", Ложь, "", "", "");
	Ид = Формат(Заявка.Получить("request_id"), "ЧГ=0");
	Маркер = ЗначениеСтроки(Заявка.Получить("marker"));
	Попытка
		Если Метаданные.Документы.Найти(ВидДокумента) = Неопределено Тогда
			ВызватьИсключение СтрШаблон("У конфігурації немає документа «%1» — вкажіть вид документа на вкладці «Налаштування»",
				ВидДокумента);
		КонецЕсли;
		Контрагент = Заявка.Получить("counterparty");
		Если ТипЗнч(Контрагент) = Тип("Соответствие") И Контрагент.Получить("in_1c") = Ложь Тогда
			ВызватьИсключение "Контрагента заявки ще немає в 1С — заведіть його в 1С і прив'яжіть у заявці PayDesk";
		КонецЕсли;
		// Платіжку вже створено раніше, а PayDesk не отримав відмітки (обірвався зв'язок) — не дублюємо
		Ссылка = НайтиСозданный(ВидДокумента, Маркер);
		Если Ссылка = Неопределено Тогда
			Документ = Документы[ВидДокумента].СоздатьДокумент();
			Предупреждения = Новый Массив;
			ЗаполнитьДокумент(Документ, ВидДокумента, Заявка, Правила, Предупреждения);
			Документ.Записать(РежимЗаписиДокумента.Запись);
			Ссылка = Документ.Ссылка;
			Результат.Предупреждения = СтрСоединить(Предупреждения, "; ");
		КонецЕсли;
		Номер = СокрЛП(Ссылка.Номер);
		Тело = Новый Структура;
		Тело.Вставить("doc_ref", Строка(Ссылка.УникальныйИдентификатор()));
		Тело.Вставить("doc_number", ?(ЗначениеЗаполнено(Номер), Номер, "без номера"));
		Тело.Вставить("doc_date", Формат(Ссылка.Дата, "ДФ=yyyy-MM-dd"));
		Тело.Вставить("doc_type", ВидДокумента);
		Тело.Вставить("user", ПолноеИмяПользователя());
		ЗапросPayDesk(Адрес, Ключ, "POST", "/api/1c/v1/payment-orders/" + Ид + "/created", Тело);
		Результат.Успех = Истина;
		Результат.Номер = Номер;
	Исключение
		Результат.Сообщение = ИнформацияОбОшибке().Описание;
		Попытка
			Тело = Новый Структура("message, user", Лев(Результат.Сообщение, 450), ПолноеИмяПользователя());
			ЗапросPayDesk(Адрес, Ключ, "POST", "/api/1c/v1/payment-orders/" + Ид + "/failed", Тело);
		Исключение
			// PayDesk недоступний — помилку бачить бухгалтер у таблиці обробки
		КонецПопытки;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Перша наявна в конфігурації назва документа платіжного доручення.
Функция ВидДокументаПоУмолчанию() Экспорт
	Для Каждого Имя Из СтрРазделить("ПлатежноеПоручениеИсходящее,ПлатежноеПоручение,СписаниеСРасчетногоСчета,"
			+ "СписаниеБезналичныхДенежныхСредств,РасходДенежныхСредств", ",") Цикл
		Если Метаданные.Документы.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "ПлатежноеПоручениеИсходящее";
КонецФункции

// Правила заповнення за замовчуванням (назви — як у типових конфігураціях; відсутні реквізити пропускаються).
Функция СопоставлениеПоУмолчанию() Экспорт
	Таблица = НоваяТаблицаПравил();
	ДобавитьПравило(Таблица, "Дата", "today");
	ДобавитьПравило(Таблица, "Организация", "organization", "Организации", "КодПоЕДРПОУ", "edrpou");
	ДобавитьПравило(Таблица, "Контрагент", "counterparty", "Контрагенты", "КодПоЕДРПОУ", "edrpou");
	ДобавитьПравило(Таблица, "СуммаДокумента", "amount");
	ДобавитьПравило(Таблица, "ВалютаДокумента", "currency", "Валюты", "Наименование", "name");
	ДобавитьПравило(Таблица, "НазначениеПлатежа", "purpose");
	ДобавитьПравило(Таблица, "Комментарий", "comment");
	ДобавитьПравило(Таблица, "Подразделение", "department", "Подразделения", "Наименование", "name");
	Возврат Таблица;
КонецФункции

// Що можна взяти із заявки PayDesk (колонка «Звідки» правил).
Функция Источники() Экспорт
	Список = Новый СписокЗначений;
	Список.Добавить("today", "Поточна дата");
	Список.Добавить("pay_date", "Дата оплати з заявки");
	Список.Добавить("organization", "Організація (довідник)");
	Список.Добавить("counterparty", "Контрагент (довідник)");
	Список.Добавить("currency", "Валюта (довідник)");
	Список.Добавить("department", "Відділ (довідник)");
	Список.Добавить("payment_type", "Вид оплати (довідник)");
	Список.Добавить("expense_item", "Стаття витрат (довідник, за кодом)");
	Список.Добавить("amount", "Сума");
	Список.Добавить("purpose", "Призначення платежу (з #номером заявки)");
	Список.Добавить("comment", "Коментар «PayDesk #номер · посилання»");
	Список.Добавить("note", "Коментар автора заявки");
	Возврат Список;
КонецФункции

// Документи конфігурації, схожі на платіжки, і реквізити вибраного — щоб налаштувати обробку без програміста.
Функция ОписаниеДокументов(ВидДокумента) Экспорт
	Строки = Новый Массив;
	Строки.Добавить("Документи, схожі на платіжні доручення (назва — синонім):");
	Для Каждого МД Из Метаданные.Документы Цикл
		Текст = НРег(МД.Имя + " " + МД.Синоним);
		Если СтрНайти(Текст, "плат") > 0 Или СтрНайти(Текст, "списан") > 0 Или СтрНайти(Текст, "расход") > 0
			Или СтрНайти(Текст, "оплат") > 0 Тогда
			Строки.Добавить("  " + МД.Имя + " — " + МД.Синоним);
		КонецЕсли;
	КонецЦикла;
	МД = Метаданные.Документы.Найти(ВидДокумента);
	Если МД = Неопределено Тогда
		Строки.Добавить("");
		Строки.Добавить(СтрШаблон("Документа «%1» у конфігурації немає.", ВидДокумента));
	Иначе
		Строки.Добавить("");
		Строки.Добавить(СтрШаблон("Реквізити документа %1 (назва — синонім — тип):", ВидДокумента));
		Для Каждого Реквизит Из МД.Реквизиты Цикл
			Строки.Добавить("  " + Реквизит.Имя + " — " + Реквизит.Синоним + " — " + Строка(Реквизит.Тип));
		КонецЦикла;
		Для Каждого Таблица Из МД.ТабличныеЧасти Цикл
			Строки.Добавить("  [таблична частина] " + Таблица.Имя + " — " + Таблица.Синоним);
		КонецЦикла;
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Чи знаходиться контрагент першої заявки в 1С за GUID з PayDesk (перевірка формату GUID під час «Перевірити зв'язок»).
Функция ПроверитьGUID(Заявка, Правила) Экспорт
	Правило = Правила.Найти("Контрагент", "Реквизит");
	Если Правило = Неопределено Или Не ЗначениеЗаполнено(Правило.Справочник) Тогда
		Возврат "";
	КонецЕсли;
	Данные = Заявка.Получить("counterparty");
	Если ТипЗнч(Данные) <> Тип("Соответствие") Или Не ЗначениеЗаполнено(Данные.Получить("ref")) Тогда
		Возврат "У першої заявки контрагент без GUID 1С.";
	КонецЕсли;
	Ссылка = СсылкаПоGUID(Правило.Справочник, Данные.Получить("ref"));
	Если Ссылка <> Неопределено Тогда
		Возврат СтрШаблон("Контрагента першої заявки знайдено в 1С за GUID: %1.", Строка(Ссылка));
	КонецЕсли;
	Возврат СтрШаблон("Контрагента першої заявки («%1») за GUID у довіднику «%2» не знайдено — перевірте назву довідника "
		+ "або формат GUID (див. README). Пошук за %3 працюватиме як запасний.",
		ЗначениеСтроки(Данные.Получить("name")), Правило.Справочник, Правило.РеквизитПоиска);
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокумента

Процедура ЗаполнитьДокумент(Документ, ВидДокумента, Заявка, Правила, Предупреждения)
	МД = Метаданные.Документы[ВидДокумента];
	Для Каждого Правило Из Правила Цикл
		Если Не ЗначениеЗаполнено(Правило.Реквизит) Или Не ЕстьРеквизит(МД, Правило.Реквизит) Тогда
			Продолжить;  // у цій конфігурації такого реквізиту немає
		КонецЕсли;
		Значение = ЗначениеИзЗаявки(Заявка, Правило);
		Если Значение = Неопределено Тогда
			Предупреждения.Добавить(СтрШаблон("не заповнено «%1»", Правило.Реквизит));
			Продолжить;
		КонецЕсли;
		Документ[Правило.Реквизит] = Значение;
	КонецЦикла;
	// ПІДЛАШТУВАТИ ПІД КОНФІГУРАЦІЮ: рахунок організації (з виду оплати), рахунок і договір контрагента, стаття руху
	// коштів, ПДВ, таблична частина розшифровки платежу — див. README, розділ «Що доробити в обробці».
КонецПроцедуры

Функция ЗначениеИзЗаявки(Заявка, Правило)
	Источник = Правило.Источник;
	Если Источник = "today" Тогда
		Возврат ТекущаяДатаСеанса();
	ИначеЕсли Источник = "pay_date" Тогда
		Возврат ДатаИзСтроки(Заявка.Получить("pay_date"));
	ИначеЕсли Источник = "amount" Тогда
		Возврат Число(Заявка.Получить("amount"));
	ИначеЕсли Источник = "purpose" Тогда
		Возврат ЗначениеСтроки(Заявка.Получить("purpose"));
	ИначеЕсли Источник = "comment" Тогда
		Возврат "PayDesk " + ЗначениеСтроки(Заявка.Получить("marker")) + " · " + ЗначениеСтроки(Заявка.Получить("url"));
	ИначеЕсли Источник = "note" Тогда
		Возврат ЗначениеСтроки(Заявка.Получить("note"));
	КонецЕсли;
	// Довідники: спершу за GUID з PayDesk, потім за реквізитом (ЄДРПОУ, код, назва)
	Ключ = ?(Источник = "currency", "currency_ref", Источник);
	Данные = Заявка.Получить(Ключ);
	Если ТипЗнч(Данные) <> Тип("Соответствие") Или Не ЗначениеЗаполнено(Правило.Справочник) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ссылка = СсылкаПоGUID(Правило.Справочник, Данные.Получить("ref"));
	Если Ссылка = Неопределено И ЗначениеЗаполнено(Правило.РеквизитПоиска) И ЗначениеЗаполнено(Правило.ПолеПоиска) Тогда
		Ссылка = НайтиПоРеквизиту(Правило.Справочник, Правило.РеквизитПоиска, ЗначениеСтроки(Данные.Получить(Правило.ПолеПоиска)));
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция ЕстьРеквизит(МД, Имя)
	Если МД.Реквизиты.Найти(Имя) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Реквизит Из МД.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Посилання на елемент довідника за GUID 1С (у PayDesk — уже переставлений з формату SQL) або Неопределено.
Функция СсылкаПоGUID(ИмяСправочника, GUID)
	Если Не ЗначениеЗаполнено(GUID) Или Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Справочники[ИмяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор(GUID));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	// ПолучитьСсылку повертає посилання й на неіснуючий елемент — перевіряємо запитом
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Справочник." + ИмяСправочника + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат ?(Запрос.Выполнить().Пустой(), Неопределено, Ссылка);
КонецФункции

Функция НайтиПоРеквизиту(ИмяСправочника, Реквизит, Значение)
	МД = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МД = Неопределено Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Менеджер = Справочники[ИмяСправочника];
	Если Реквизит = "Наименование" Тогда
		Ссылка = Менеджер.НайтиПоНаименованию(Значение, Истина);
	ИначеЕсли Реквизит = "Код" Тогда
		Ссылка = Менеджер.НайтиПоКоду(Значение);
	ИначеЕсли МД.Реквизиты.Найти(Реквизит) <> Неопределено Тогда
		Ссылка = Менеджер.НайтиПоРеквизиту(Реквизит, Значение);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Возврат ?(Ссылка.Пустая(), Неопределено, Ссылка);
КонецФункции

// Уже створена обробкою платіжка цієї заявки (за коментарем «PayDesk #номер …»), не позначена на видалення.
Функция НайтиСозданный(ВидДокумента, Маркер)
	МД = Метаданные.Документы[ВидДокумента];
	Если Не ЗначениеЗаполнено(Маркер) Или МД.Реквизиты.Найти("Комментарий") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Документ." + ВидДокумента + " КАК Д
		|ГДЕ НЕ Д.ПометкаУдаления И ВЫРАЗИТЬ(Д.Комментарий КАК СТРОКА(300)) ПОДОБНО &Шаблон");
	Запрос.УстановитьПараметр("Шаблон", "PayDesk " + Маркер + " %");
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

Функция НоваяТаблицаПравил() Экспорт
	Таблица = Новый ТаблицаЗначений;
	Для Каждого Колонка Из СтрРазделить("Реквизит,Источник,Справочник,РеквизитПоиска,ПолеПоиска", ",") Цикл
		Таблица.Колонки.Добавить(Колонка, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Возврат Таблица;
КонецФункции

Процедура ДобавитьПравило(Таблица, Реквизит, Источник, Справочник = "", РеквизитПоиска = "", ПолеПоиска = "")
	Правило = Таблица.Добавить();
	Правило.Реквизит = Реквизит;
	Правило.Источник = Источник;
	Правило.Справочник = Справочник;
	Правило.РеквизитПоиска = РеквизитПоиска;
	Правило.ПолеПоиска = ПолеПоиска;
КонецПроцедуры

#КонецОбласти

#Область HTTP

// Запит до PayDesk; відповідь — Соответствие. Помилка мережі чи PayDesk — виняток із текстом для бухгалтера.
Функция ЗапросPayDesk(Адрес, Ключ, Метод, Путь, Тело = Неопределено) Экспорт
	Части = РазобратьАдрес(Адрес);
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		ВызватьИсключение "Вкажіть ключ API (PayDesk → Налаштування → API для 1С → «Створити ключ»)";
	КонецЕсли;
	Защищенное = ?(Части.HTTPS, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
	Соединение = Новый HTTPСоединение(Части.Хост, Части.Порт, , , , 60, Защищенное);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Api-Key", СокрЛП(Ключ));
	Заголовки.Вставить("Accept", "application/json");
	Если Тело <> Неопределено Тогда
		Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Части.Префикс + Путь, Заголовки);
	Если Тело <> Неопределено Тогда
		Запрос.УстановитьТелоИзСтроки(ВJSON(Тело), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Иначе
		Ответ = Соединение.Получить(Запрос);
	КонецЕсли;
	Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Данные = Неопределено;
	Попытка
		Данные = ИзJSON(Текст);
	Исключение
		Данные = Неопределено;
	КонецПопытки;
	Если Ответ.КодСостояния <> 200 Тогда
		Пояснение = Лев(Текст, 300);
		Если ТипЗнч(Данные) = Тип("Соответствие") И Данные.Получить("error") <> Неопределено Тогда
			Пояснение = Данные.Получить("error");
		КонецЕсли;
		ВызватьИсключение СтрШаблон("PayDesk відповів %1: %2", Ответ.КодСостояния, Пояснение);
	КонецЕсли;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "PayDesk повернув не JSON — перевірте адресу PayDesk";
	КонецЕсли;
	Возврат Данные;
КонецФункции

// «https://host[:порт][/шлях]» → Структура (Хост, Порт, HTTPS, Префикс).
Функция РазобратьАдрес(Адрес)
	Текст = СокрЛП(Адрес);
	HTTPS = Истина;
	Если НРег(Лев(Текст, 8)) = "https://" Тогда
		Текст = Сред(Текст, 9);
	ИначеЕсли НРег(Лев(Текст, 7)) = "http://" Тогда
		Текст = Сред(Текст, 8);
		HTTPS = Ложь;
	КонецЕсли;
	Префикс = "";
	Позиция = СтрНайти(Текст, "/");
	Если Позиция > 0 Тогда
		Префикс = Сред(Текст, Позиция);
		Текст = Лев(Текст, Позиция - 1);
	КонецЕсли;
	Если Прав(Префикс, 1) = "/" Тогда
		Префикс = Лев(Префикс, СтрДлина(Префикс) - 1);
	КонецЕсли;
	Порт = ?(HTTPS, 443, 80);
	Позиция = СтрНайти(Текст, ":");
	Если Позиция > 0 Тогда
		Порт = Число(Сред(Текст, Позиция + 1));
		Текст = Лев(Текст, Позиция - 1);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Текст) Тогда
		ВызватьИсключение "Вкажіть адресу PayDesk, напр. https://paydesk.azurewebsites.net";
	КонецЕсли;
	Возврат Новый Структура("Хост, Порт, HTTPS, Префикс", Текст, Порт, HTTPS, Префикс);
КонецФункции

#КонецОбласти

#Область Служебные

Функция ИзJSON(Текст) Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция ВJSON(Значение) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция ДатаИзСтроки(Текст) Экспорт
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Возврат Дата(СтрЗаменить(Лев(Текст, 10), "-", ""));
КонецФункции

Функция ЗначениеСтроки(Значение) Экспорт
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

// Поле вкладеного об'єкта заявки, напр. Поле(Заявка, "counterparty", "name").
Функция Поле(Заявка, Ключ, Подключ) Экспорт
	Данные = Заявка.Получить(Ключ);
	Возврат ?(ТипЗнч(Данные) = Тип("Соответствие"), ЗначениеСтроки(Данные.Получить(Подключ)), "");
КонецФункции

Функция ПредставлениеСостояния(Состояние) Экспорт
	Если Состояние = "created" Тогда
		Возврат "Платіжку створено";
	ИначеЕсли Состояние = "failed" Тогда
		Возврат "Помилка 1С";
	ИначеЕсли Состояние = "cancelled" Тогда
		Возврат "Заявку повернули — платіжку видалити";
	КонецЕсли;
	Возврат "Нова";
КонецФункции

