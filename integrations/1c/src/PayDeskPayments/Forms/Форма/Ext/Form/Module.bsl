// Форма обробки «Платіжки із заявок PayDesk»: підключення, список заявок, створення платіжок, правила заповнення.
// Логіка (HTTP, JSON, створення документів) — у модулі об'єкта.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Список = Элементы.СостояниеЗаявок.СписокВыбора;
	Список.Добавить("new", "Нові — платіжки ще немає");
	Список.Добавить("failed", "З помилкою 1С");
	Список.Добавить("created", "Платіжку створено");
	Список.Добавить("cancelled", "Платіжку створено, а заявку повернули");
	Список.Добавить("all", "Усі «До оплати»");
	Список = Элементы.ФормаОплаты.СписокВыбора;
	Список.Добавить("bank", "Безготівка");
	Список.Добавить("cash", "Готівка");
	Список.Добавить("all", "Усі");
	Обработка = РеквизитФормыВЗначение("Объект");
	Для Каждого Элемент Из Обработка.Источники() Цикл
		Элементы.СопоставлениеИсточник.СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	Для Каждого Поле Из СтрРазделить("edrpou,code,name", ",") Цикл
		Элементы.СопоставлениеПолеПоиска.СписокВыбора.Добавить(Поле);
	КонецЦикла;
	ЗагрузитьНастройки(Обработка);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьСвязь(Команда)
	ПоказатьПредупреждение(, ПроверитьСвязьНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаявки(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПлатежки(Команда)
	Выбрано = 0;
	Для Каждого Строка Из Заявки Цикл
		Если Строка.Выбрать Тогда
			Выбрано = Выбрано + 1;
		КонецЕсли;
	КонецЦикла;
	Если Выбрано = 0 Тогда
		ПоказатьПредупреждение(, "Позначте заявки, для яких створити платіжки.");
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, СоздатьПлатежкиНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого Строка Из Заявки Цикл
		Строка.Выбрать = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого Строка Из Заявки Цикл
		Строка.Выбрать = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНастройки(Команда)
	СохранитьНастройкиНаСервере();
	ПоказатьПредупреждение(, "Налаштування збережено.");
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДокументы(Команда)
	ПоказатьДокументыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПравилаПоУмолчанию(Команда)
	ПравилаПоУмолчаниюНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПроверитьСвязьНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Попытка
		Ответ = Обработка.Пинг(АдресPayDesk, КлючAPI);
		Список = Обработка.ПолучитьЗаявки(АдресPayDesk, КлючAPI, "new", "");
	Исключение
		Возврат "Немає зв'язку з PayDesk: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	СохранитьНастройкиНаСервере();
	Текст = СтрШаблон("Зв'язок з %1 є, ключ правильний. Нових заявок «До оплати»: %2.",
		Обработка.ЗначениеСтроки(Ответ.Получить("app")), Список.Количество());
	Если Метаданные.Документы.Найти(ВидДокумента) = Неопределено Тогда
		Текст = Текст + Символы.ПС + СтрШаблон("Увага: у конфігурації немає документа «%1» — вкажіть вид документа "
			+ "(кнопка «Документи конфігурації» на вкладці «Налаштування»).", ВидДокумента);
	КонецЕсли;
	Если Список.Количество() > 0 Тогда
		ПроверкаGUID = Обработка.ПроверитьGUID(Список[0], РеквизитФормыВЗначение("Сопоставление"));
		Если ЗначениеЗаполнено(ПроверкаGUID) Тогда
			Текст = Текст + Символы.ПС + ПроверкаGUID;
		КонецЕсли;
	КонецЕсли;
	Возврат Текст;
КонецФункции

&НаСервере
Процедура ОбновитьНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Заявки.Очистить();
	Попытка
		Список = Обработка.ПолучитьЗаявки(АдресPayDesk, КлючAPI, СостояниеЗаявок, ?(ФормаОплаты = "all", "", ФормаОплаты));
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ИнформацияОбОшибке().Описание;
		Сообщение.Сообщить();
		Возврат;
	КонецПопытки;
	Для Каждого Заявка Из Список Цикл
		Строка = Заявки.Добавить();
		Строка.Ид = Заявка.Получить("request_id");
		Строка.Номер = Обработка.ЗначениеСтроки(Заявка.Получить("number"));
		Строка.ДатаОплаты = Обработка.ДатаИзСтроки(Заявка.Получить("pay_date"));
		Строка.Организация = Обработка.Поле(Заявка, "organization", "name");
		Строка.Контрагент = Обработка.Поле(Заявка, "counterparty", "name");
		Строка.Сумма = Число(Заявка.Получить("amount"));
		Строка.Валюта = Обработка.ЗначениеСтроки(Заявка.Получить("currency"));
		Строка.Назначение = Обработка.ЗначениеСтроки(Заявка.Получить("purpose"));
		Строка.Состояние = Обработка.ПредставлениеСостояния(Заявка.Получить("onec_state"));
		Строка.Документ = Обработка.Поле(Заявка, "onec_order", "doc_number");
		Строка.Примечание = Обработка.Поле(Заявка, "onec_order", "message");
		Строка.Данные = Обработка.ВJSON(Заявка);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СоздатьПлатежкиНаСервере()
	СохранитьНастройкиНаСервере();
	Обработка = РеквизитФормыВЗначение("Объект");
	Правила = РеквизитФормыВЗначение("Сопоставление");
	Создано = 0;
	Ошибок = 0;
	Для Каждого Строка Из Заявки Цикл
		Если Не Строка.Выбрать Тогда
			Продолжить;
		КонецЕсли;
		Результат = Обработка.СоздатьПлатежку(АдресPayDesk, КлючAPI, ВидДокумента, Обработка.ИзJSON(Строка.Данные), Правила);
		Если Результат.Успех Тогда
			Создано = Создано + 1;
			Строка.Выбрать = Ложь;
			Строка.Документ = Результат.Номер;
			Строка.Состояние = "Платіжку створено";
			Строка.Примечание = Результат.Предупреждения;
		Иначе
			Ошибок = Ошибок + 1;
			Строка.Состояние = "Помилка 1С";
			Строка.Примечание = Результат.Сообщение;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрШаблон("Створено платіжок: %1. З помилкою: %2 (текст — у колонці «Примітка», його бачить і PayDesk).",
		Создано, Ошибок);
КонецФункции

&НаСервере
Процедура ПоказатьДокументыНаСервере()
	Справка = РеквизитФормыВЗначение("Объект").ОписаниеДокументов(ВидДокумента);
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки;
КонецПроцедуры

&НаСервере
Процедура ПравилаПоУмолчаниюНаСервере()
	ЗначениеВРеквизитФормы(РеквизитФормыВЗначение("Объект").СопоставлениеПоУмолчанию(), "Сопоставление");
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки(Обработка)
	Настройки = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Основные");
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Для Каждого Имя Из СтрРазделить("АдресPayDesk,КлючAPI,ВидДокумента,СостояниеЗаявок,ФормаОплаты", ",") Цикл
			Если Настройки.Свойство(Имя) Тогда
				ЭтотОбъект[Имя] = Настройки[Имя];
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВидДокумента) Тогда
		ВидДокумента = Обработка.ВидДокументаПоУмолчанию();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СостояниеЗаявок) Тогда
		СостояниеЗаявок = "new";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ФормаОплаты) Тогда
		ФормаОплаты = "bank";
	КонецЕсли;
	Таблица = Неопределено;
	Если ТипЗнч(Настройки) = Тип("Структура") И Настройки.Свойство("Сопоставление") Тогда
		Таблица = Настройки.Сопоставление;
	КонецЕсли;
	Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Или Таблица.Количество() = 0 Тогда
		Таблица = Обработка.СопоставлениеПоУмолчанию();
	КонецЕсли;
	ЗначениеВРеквизитФормы(Таблица, "Сопоставление");
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()
	Настройки = Новый Структура("АдресPayDesk, КлючAPI, ВидДокумента, СостояниеЗаявок, ФормаОплаты",
		СокрЛП(АдресPayDesk), СокрЛП(КлючAPI), СокрЛП(ВидДокумента), СостояниеЗаявок, ФормаОплаты);
	Настройки.Вставить("Сопоставление", РеквизитФормыВЗначение("Сопоставление"));
	ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Основные", Настройки);
КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючНастроек()
	Возврат "PayDeskPayments";
КонецФункции

#КонецОбласти
