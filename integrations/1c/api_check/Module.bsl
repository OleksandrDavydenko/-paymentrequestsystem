// Обробка «PayDesk: дані з API» — перевірка API PayDesk для 1С. Вставте ключ API і натисніть «Отримати дані з PayDesk»:
// обробка покаже заявки «До оплати», як їх віддає PayDesk. Нічого не створює й не змінює ні в 1С, ні в PayDesk —
// лише читає (GET). Запити йдуть з комп'ютера користувача (клієнт), тож серверу 1С доступ в інтернет не потрібен.
// Поле «Ключ API» — реквізит обробки «Путь» (назва лишилася від обробки-зразка).

&НаКлиенте
Процедура ПутьНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ВивантажитиТаблиці(Команда)
	Ключ = СокрЛП(Объект.Путь);
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		ПоказатьПредупреждение(, "Вставте ключ API з PayDesk («Налаштування → API для 1С» → «Створити ключ»).");
		Возврат;
	КонецЕсли;
	Попытка
		Пінг = ЗапитPayDesk(Ключ, "/api/1c/v1/ping");
		Дані = ЗапитPayDesk(Ключ, "/api/1c/v1/payment-orders?state=all");
	Исключение
		ПоказатьПредупреждение(, "Не вдалося отримати дані з PayDesk: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(ОписатиЗаявки(Пінг, Дані));
	Документ.Показать("PayDesk — заявки до оплати");
КонецПроцедуры

// GET-запит до PayDesk; відповідь — Соответствие. Помилка мережі чи PayDesk — виняток із текстом.
&НаКлиенте
Функция ЗапитPayDesk(Ключ, Шлях)
	Захищене = Новый ЗащищенноеСоединениеOpenSSL();
	Соединение = Новый HTTPСоединение(АдресаPayDesk(), 443, , , , 60, Захищене);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Api-Key", Ключ);
	Заголовки.Вставить("Accept", "application/json");
	Ответ = Соединение.Получить(Новый HTTPЗапрос(Шлях, Заголовки));
	Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Дані = Неопределено;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Дані = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Дані = Неопределено;
	КонецПопытки;
	Если Ответ.КодСостояния <> 200 Тогда
		Пояснення = Лев(Текст, 300);
		Если ТипЗнч(Дані) = Тип("Соответствие") И Дані.Получить("error") <> Неопределено Тогда
			Пояснення = Дані.Получить("error");
		КонецЕсли;
		ВызватьИсключение "PayDesk відповів " + Формат(Ответ.КодСостояния, "ЧГ=0") + ": " + Пояснення;
	КонецЕсли;
	Если ТипЗнч(Дані) <> Тип("Соответствие") Тогда
		ВызватьИсключение "PayDesk повернув не JSON";
	КонецЕсли;
	Возврат Дані;
КонецФункции

// Заявки — по-людськи, далі повна відповідь API (JSON), щоб бачити всі поля.
&НаКлиенте
Функция ОписатиЗаявки(Пінг, Дані)
	Рядки = Новый Массив;
	Рядки.Добавить("PayDesk: " + Значення(Пінг, "app") + " · API " + Значення(Пінг, "api") + " · час сервера " + Значення(Пінг, "time"));
	Заявки = Дані.Получить("items");
	Если ТипЗнч(Заявки) <> Тип("Массив") Тогда
		Заявки = Новый Массив;
	КонецЕсли;
	Рядки.Добавить("Заявок «До оплати»: " + Формат(Заявки.Количество(), "ЧН=0; ЧГ=0"));
	Для Каждого Заявка Из Заявки Цикл
		Рядки.Добавить("");
		Рядки.Добавить("№ " + Значення(Заявка, "number") + " · оплата " + Значення(Заявка, "pay_date")
			+ " · " + ?(Значення(Заявка, "payment_form") = "cash", "готівка", "безготівка") + " · " + Значення(Заявка, "status_name"));
		Рядки.Добавить("    Сума: " + Значення(Заявка, "amount") + " " + Значення(Заявка, "currency"));
		Рядки.Добавить("    Організація: " + Вкладене(Заявка, "organization", "name") + " (ЄДРПОУ " + Вкладене(Заявка, "organization", "edrpou") + ")");
		Рядки.Добавить("    Контрагент: " + Вкладене(Заявка, "counterparty", "name") + " (ЄДРПОУ " + Вкладене(Заявка, "counterparty", "edrpou")
			+ ", GUID 1С " + Вкладене(Заявка, "counterparty", "ref") + ")");
		Рядки.Добавить("    Вид оплати: " + Вкладене(Заявка, "payment_type", "name"));
		Рядки.Добавить("    Стаття: " + Вкладене(Заявка, "expense_item", "code") + " " + Вкладене(Заявка, "expense_item", "name")
			+ " · Відділ: " + Вкладене(Заявка, "department", "name"));
		Рядки.Добавить("    Призначення: " + Значення(Заявка, "purpose"));
		Рядки.Добавить("    Платіжка в 1С: " + Значення(Заявка, "onec_state") + " · " + Значення(Заявка, "url"));
	КонецЦикла;
	Рядки.Добавить("");
	Рядки.Добавить("———————— Повна відповідь API (JSON) ————————");
	Запис = Новый ЗаписьJSON;
	Запис.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
	ЗаписатьJSON(Запис, Дані);
	Рядки.Добавить(Запис.Закрыть());
	Возврат СтрСоединить(Рядки, Символы.ПС);
КонецФункции

&НаКлиенте
Функция Значення(Дані, Ключ)
	Если ТипЗнч(Дані) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Значение = Дані.Получить(Ключ);
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

&НаКлиенте
Функция Вкладене(Дані, Ключ, Підключ)
	Возврат Значення(?(ТипЗнч(Дані) = Тип("Соответствие"), Дані.Получить(Ключ), Неопределено), Підключ);
КонецФункции

&НаКлиенте
Функция АдресаPayDesk()
	Возврат "paymentrequestsystem-ece9b4b4g0dbe7fu.polandcentral-01.azurewebsites.net";
КонецФункции
